# ============================================
# Environment Variables for Disaster Response System
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================

# n8n API Key (JWT token from n8n Settings > API)
# Required for: setup_n8n_workflows.py, update_n8n_live.py
N8N_API_KEY=your_n8n_api_key_here

# n8n Base URL (default: http://localhost:5678/api/v1)
N8N_BASE_URL=http://localhost:5678/api/v1

# Data source for backend (options: static, mongodb, google_sheets, osm)
DATA_SOURCE=osm

# Flask server port
FLASK_PORT=5000

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8501
